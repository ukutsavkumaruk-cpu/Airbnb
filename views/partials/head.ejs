<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/output.css">
  <title><%= pageTitle %></title>
</head>

<body>
  <header class="site-header">
    <nav class="site-nav" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="Staybnb home">
        <span class="brand-mark" aria-hidden="true">s</span>
        <span>staybnb</span>
      </a>

      <div class="nav-links">
        <a class="nav-link" href="/">Explore stays</a>
        <% if(isLoggedIn) { %>
          <% if (user && user.userType === "host") { %>
            <a class="nav-link" href="/host/add-Home?editing=false">Add a stay</a>
            <a class="nav-link" href="/host/host-home-list">Your listings</a>
          <% } %>
          <% if(user && user.userType === "guest") { %>
            <a class="nav-link" href="/store/bookings">Bookings</a>
            <a class="nav-link" href="/store/favourite-list">Favourites</a>
          <% } %>
        <% } %>
      </div>

      <div class="nav-actions">
        <% if(!isLoggedIn) { %>
          <a class="nav-login" href="/login">Log in</a>
          <a class="nav-signup" href="/signUp">Sign up</a>
        <% } else { %>
          <form action="/logout" method="post">
            <button class="nav-login" type="submit">Log out</button>
          </form>
        <% } %>
      </div>
    </nav>
  </header>
