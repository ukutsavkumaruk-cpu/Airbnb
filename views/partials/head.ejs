<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/output.css">
  <title>
    <%= pageTitle %>
  </title>
</head>

<body>
  <header>
    <div class="w-full h-24 bg-pink-500 flex items-center justify-center ">
      <h1 class="text-white text-4xl font-bold tracking-wide">
        Welcome Airbnb 🏠
      </h1>
    </div>
    <div class="bg-pink-500 p-4">
      <ul class="flex gap-18 ">

        <li>
          <a class="inline-block bg-pink-500 hover:bg-pink-600 text-white font-semibold px-5 py-2.5 rounded-lg  transition duration-200"
            href="/">
            Home
          </a>
        </li>

        <li>
          <a class="inline-block bg-pink-500 hover:bg-pink-600 text-white font-semibold px-5 py-2.5 rounded-lg  transition duration-200"
            href="/host/add-Home?editing=false">
            Add Home
          </a>
        </li>

        <li>
          <a class="inline-block bg-pink-500 hover:bg-pink-600 text-white font-semibold px-5 py-2.5 rounded-lg  transition duration-200"
            href="/store/bookings">
            Bookings
          </a>
        </li>

        <li>
          <a class="inline-block bg-pink-500 hover:bg-pink-600 text-white font-semibold px-5 py-2.5 rounded-lg  transition duration-200"
            href="/store/favourite-list">
            Favourites
          </a>
        </li>
        <li>
          <a class="inline-block bg-pink-500 hover:bg-pink-600 text-white font-semibold px-5 py-2.5 rounded-lg  transition duration-200"
            href="/host/host-home-list">
            Host Homes
          </a>
        </li>

      </ul>
    </div>
  </header>