<% addedHomes.forEach(home => { %>
  <article class="stay-card">
    <div class="stay-card-image">
      <img src="<%= home.Img %>" alt="<%= home.Name %>">
      <div class="price-badge">₹<%= home.Price %> <span>/ night</span></div>
    </div>
    <div class="stay-card-content">
      <h2><%= home.Name %></h2>
      <p class="stay-location"><span aria-hidden="true">⌖</span><span><%= home.Location %></span></p>
      <a href="/rules/<%= home.homeRules %>" class="house-rules-link">House rules <span aria-hidden="true">→</span></a>
      <div class="stay-contact">
        <p><%= home.Email %></p>
        <p><%= home.Phone %></p>
      </div>
      <div class="card-actions">
        <button class="button-success" type="button">Book</button>
        <a href="/store/home-detail/<%= home._id %>" class="button-secondary">View details</a>
      </div>
      <div class="favourite-form">
        <%- include('./favourites',{home:home}) %>
      </div>
    </div>
  </article>
<% }) %>