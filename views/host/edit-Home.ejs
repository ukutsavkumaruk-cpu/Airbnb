<%- include('../partials/head') %>

  <body>

    <main class="page-shell">
      <section class="auth-panel auth-panel-wide">
        <h1 class="auth-title">
          <%= editing ? "Edit your home" : " Add Your Home" %>
        </h1>
        <p class="auth-subtitle">Share the details guests need to find your place.</p>
        <form action="/host/<%= editing? 'edit-Home/'+home._id : 'add-Home' %>" method="POST" enctype="multipart/form-data" class="form-stack">
          <div class="form-field">
            <label for="home">Home name</label>
            <input id="home" type="text" placeholder="Enter home name" value="<%= editing ? home.Name : '' %>" name="home" required>
          </div>
          <div class="form-field">
            <label for="image">Home photo</label>
            <input id="image" type="file" accept="image/jpeg,image/png,image/jpg" value="<%= editing ? home.Img : '' %>" name="image" required>
          </div>
          <div class="form-field">
            <label for="location">Location</label>
            <input id="location" type="text" value="<%= editing ? home.Location : '' %>" placeholder="Enter home location" name="location" required>
          </div>
          <div class="form-field">
            <label for="price">Price per night (₹)</label>
            <input id="price" type="number" value="<%= editing ? home.Price : '' %>" placeholder="Enter price" name="price" min="0" required>
          </div>
          <div class="form-field">
            <label for="email">Contact email</label>
            <input id="email" type="email" value="<%= editing ? home.Email : '' %>" placeholder="Enter email" name="email" required>
          </div>
          <div class="form-field">
            <label for="phone">Phone number</label>
            <input id="phone" type="tel" value="<%= editing ? home.Phone : '' %>" placeholder="Enter phone number" name="phone" required>
          </div>
          <div class="form-field">
            <label for="homeRules">House rules (PDF)</label>
            <input id="homeRules" type="file" accept=".pdf,application/pdf" value="<%= editing ? home.homeRules : '' %>" name="homeRules" required>
          </div>
          <button type="submit" class="button-primary form-submit">
            <%= editing? 'Save Edit' : 'Add Home' %>
          </button>
        </form>
      </section>
    </main>

  </body>

  </html>