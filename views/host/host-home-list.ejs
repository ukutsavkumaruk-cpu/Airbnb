<%- include('../partials/head',{user : user}) %>
<main class="page-shell">
  <div class="page-heading">
    <h1>Your listings</h1>
    <p>Manage the places you are sharing with guests.</p>
  </div>
  <% if (addedHomes.length === 0) { %>
    <div class="empty-state">
      <h2>No listings yet</h2>
      <p>Add your first stay and start welcoming guests.</p>
      <a href="/host/add-Home?editing=false" class="button-primary">Add a stay</a>
    </div>
  <% } else { %>
  <div class="listing-grid">
      <%- include('../partials/hostHomeCard', { addedHomes: addedHomes }) %>
  </div>
  <% } %>
</main>
</body>
</html>