<%- include('../partials/head') %>
<main class="page-shell">
  <section class="auth-panel">
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-subtitle">Log in to continue to your next great stay.</p>

    <% if(errors.length > 0) { %>
      <div class="form-error" role="alert"><%= errors[0] %></div>
    <% } %>

    <form action="/login" method="POST" class="form-stack">
      <div class="form-field">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" placeholder="you@example.com" value="<%= oldInput.userName %>" autocomplete="email" required>
      </div>
      <div class="form-field">
        <label for="password">Password</label>
        <input id="password" type="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>
      </div>
      <button type="submit" class="button-primary form-submit">Log in</button>
    </form>

    <p class="auth-footer">New to Staybnb? <a href="/signUp">Create an account</a></p>
  </section>
</main>
</body>
</html>
