<%- include('../partials/head') %>
<main class="page-shell">
  <section class="auth-panel auth-panel-wide">
    <div>
      <h1 class="auth-title">Create your account</h1>
      <p class="auth-subtitle">Join us to discover or share a special place to stay.</p>
    </div>

    <form action="/signUp" method="POST" class="form-stack">
      <% if (errors.length > 0) { %>
        <div class="form-error" role="alert">
          <strong>Please fix the following errors:</strong>
          <ul>
            <% errors.forEach(err => { %><li><%= err %></li><% }) %>
          </ul>
        </div>
      <% } %>
      <div class="form-grid">
        <div class="form-field">
          <label for="firstName">First name</label>
          <input id="firstName" name="firstName" value="<%= oldInput.firstName %>" type="text" autocomplete="given-name" required>
        </div>
        <div class="form-field">
          <label for="lastName">Last name <span>(optional)</span></label>
          <input id="lastName" name="lastName" value="<%= oldInput.lastName %>" type="text" autocomplete="family-name">
        </div>
      </div>
      <div class="form-field">
        <label for="userName">Username or email</label>
        <input id="userName" name="userName" type="text" value="<%= oldInput.userName %>" autocomplete="username" required>
      </div>
      <div class="form-grid">
        <div class="form-field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" value="<%= oldInput.password %>" autocomplete="new-password" required>
        </div>
        <div class="form-field">
          <label for="confirmPassword">Confirm password</label>
          <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required>
        </div>
      </div>

      <fieldset>
        <legend class="form-label">I want to join as</legend>
        <div class="form-choice">
          <label>
            <input type="radio" name="userType" value="guest" required>
            Guest
          </label>
          <label>
            <input type="radio" name="userType" value="host" required>
            Host
          </label>
        </div>
      </fieldset>

      <label for="termsAccepted" class="terms-label">
        <input id="termsAccepted" name="termsAccepted" type="checkbox" value="true" required>
        <span>I agree to the Terms and Conditions.</span>
      </label>

      <button type="submit" class="button-primary form-submit">
        Create account
      </button>
    </form>

    <p class="auth-footer">Already have an account? <a href="/login">Log in</a></p>
  </section>
</main>
</body>