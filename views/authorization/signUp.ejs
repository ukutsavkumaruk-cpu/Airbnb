<%- include('../partials/head') %>
<main class="bg-gray-50 px-4 py-10 sm:py-14">
  <section class="mx-auto w-full max-w-2xl rounded-lg border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
    <div class="mb-7">
      <h2 class="text-2xl font-bold text-gray-900">Create your account</h2>
      <p class="mt-1 text-sm text-gray-600">Sign up to find or host a stay.</p>
    </div>

    <form action="/signUp" method="POST" class="space-y-5">
      <% if (errors.length > 0) { %>

  <div class="mb-6 rounded-lg border border-red-300 bg-red-50 p-4 text-red-700">

    <h3 class="mb-2 font-semibold">
      Please fix the following errors:
    </h3>

    <ul class="list-disc space-y-1 pl-5 text-sm">
      <% errors.forEach(err => { %>
        <li><%= err %></li>
      <% }) %>
    </ul>

  </div>

<% } %>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="firstName" class="mb-1.5 block text-sm font-medium text-gray-700">First name</label>
          <input id="firstName" name="firstName"  value="<%= oldInput.firstName %>" type="text" autocomplete="given-name" required 
            class="w-full rounded-md border border-gray-300 px-3 py-2.5 text-gray-900 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100">
        </div>
        <div>
          <label for="lastName" class="mb-1.5 block text-sm font-medium text-gray-700">Last name <span class="font-normal text-gray-500">(optional)</span></label>
          <input id="lastName" name="lastName" value="<%= oldInput.lastName %>" type="text" autocomplete="family-name"
            class="w-full rounded-md border border-gray-300 px-3 py-2.5 text-gray-900 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100">
        </div>
      </div>

      <div>
        <label for="userName" class="mb-1.5 block text-sm font-medium text-gray-700">Username or email</label>
        <input id="userName" name="userName" type="text" value="<%= oldInput.userName %>" autocomplete="username" required
          class="w-full rounded-md border border-gray-300 px-3 py-2.5 text-gray-900 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100">
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="password" class="mb-1.5 block text-sm font-medium text-gray-700">Password</label>
          <input id="password" name="password" type="password" value="<%= oldInput.password %>" autocomplete="new-password" required
            class="w-full rounded-md border border-gray-300 px-3 py-2.5 text-gray-900 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100">
        </div>
        <div>
          <label for="confirmPassword" class="mb-1.5 block text-sm font-medium text-gray-700">Confirm password</label>
          <input id="confirmPassword"  name="confirmPassword" type="password" autocomplete="new-password" required
            class="w-full rounded-md border border-gray-300 px-3 py-2.5 text-gray-900 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100">
        </div>
      </div>

      <fieldset>
        <legend class="mb-2 block text-sm font-medium text-gray-700">I want to join as</legend>
        <div class="flex gap-6">
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <input type="radio" name="userType" value="guest" required class="h-4 w-4 accent-blue-600">
            Guest
          </label>
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <input type="radio" name="userType" value="host" required class="h-4 w-4 accent-blue-600">
            Host
          </label>
        </div>
      </fieldset>

      <label for="termsAccepted" class="flex items-start gap-2 text-sm text-gray-700">
        <input id="termsAccepted" name="termsAccepted" type="checkbox" value="true" required
          class="mt-0.5 h-4 w-4 shrink-0 accent-blue-600">
        <span>I agree to the Terms and Conditions.</span>
      </label>

      <button type="submit" class="w-full rounded-md bg-blue-600 px-4 py-3 font-semibold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
        Create account
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-gray-600">
      Already have an account?
      <a href="/login" class="font-semibold text-blue-600 hover:underline">Log in</a>
    </p>
  </section>
</main>
<script>
</script>
</body>