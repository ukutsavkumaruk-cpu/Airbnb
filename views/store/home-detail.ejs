<%- include('../partials/head') %>
<main class="detail-layout">
  <div class="detail-image">
    <img src="<%= `/${home.Img}` %>" alt="<%= home.Name %>'s Home">
  </div>
  <section class="detail-panel">
    <h1><%= home.Name %>'s Home</h1>
    <p class="detail-location"><span aria-hidden="true">⌖</span> <%= home.Location %></p>
    <p class="detail-price">₹ <%= home.Price %> <span>/ night</span></p>
    <div class="detail-info">
      <div>
        <p class="detail-label">Owner</p>
        <p><%= home.Name %></p>
      </div>
      <div>
        <p class="detail-label">Phone</p>
        <p><%= home.Phone %></p>
      </div>
      <div>
        <p class="detail-label">Email</p>
        <p><%= home.Email %></p>
      </div>
      <div>
        <p class="detail-label">Location</p>
        <p><%= home.Location %></p>
      </div>
      <div><%- include('../partials/favourites',{home:home}) %></div>
    </div>
  </section>
</main>
</body>
</html>
