<%- include('../partials/head') %>
  <main class="page-shell">
    <div class="page-heading">
      <h1>Find your next stay</h1>
      <p>Thoughtful spaces for memorable getaways.</p>
    </div>
    <% if (addedHomes.length === 0) { %>
      <div class="empty-state">
        <h2>No stays available just yet</h2>
        <p>Check back soon to discover a place you'll love.</p>
      </div>
    <% } else { %>
    <div class="listing-grid">
      <%- include('../partials/card', { addedHomes: addedHomes }) %>
    </div>
    <% } %>
  </main>
</body>
</html>