<%- include('../partials/head') %>

  <main class="page-shell">
      <div class="page-heading">
        <h1>Your favourites</h1>
        <p>All the stays you have saved, together in one place.</p>
      </div>
      <% if (favHomeDetail.length === 0) { %>
        <div class="empty-state">
          <h2>No favourites saved yet</h2>
          <p>Save a stay you like and it will show up here.</p>
        </div>
      <% } else { %>
      <div class="listing-grid">

        <% favHomeDetail.forEach(home => { %>

          <article class="stay-card">
            <div class="stay-card-image">
              <img src="<%= `/${home.Img}` %>" alt="<%= home.Name %>">
              <div class="price-badge">₹<%= home.Price %> <span>/ night</span></div>
            </div>
            <div class="stay-card-content">
              <h2>
                <%= home.Name %>
              </h2>
              <p class="stay-location">
                <span aria-hidden="true">⌖</span>
                <span>
                  <%= home.Location %>
                </span>
              </p>
              <div class="stay-contact">
                <p>
                  <span>
                    <%= home.Email %>
                  </span>
                </p>
                <p>
                  <span>
                    <%= home.Phone %>
                  </span>
                </p>
              </div>
              <div class="card-actions">
                <button class="button-success" type="button">
                  Book
                </button>
                <a href="/store/home-detail/<%= home._id %>" class="button-secondary">
                  Details
                </a>
              </div>
              <form action="/store/favourite-list/delete" method="POST" class="favourite-form">
                <input type="hidden" name="id" value="<%= home._id %>">
                <button type="submit" class="button-danger">♡ Remove from favourites</button>
              </form>
            </div>
          </article>

        <% }) %>

      </div>
      <% } %>
  </main>

</body>
</html>